# Local-only acceptance configuration. Do not commit a real password.
# Set PORTPROJECT_RAG_DATABASE_URL in a private .env.acceptance file or in the
# process environment before running the acceptance scripts.
PORTPROJECT_RAG_ACCEPTANCE=1
PORTPROJECT_RAG_ACCEPTANCE_DATABASE=portproject_acceptance
PORTPROJECT_RAG_DATABASE_URL=postgresql://USER:CHANGE_ME@127.0.0.1:5432/portproject_acceptance
PORTPROJECT_RAG_DEPLOYMENT_ENVIRONMENT=local
PORTPROJECT_RAG_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
PORTPROJECT_RAG_COOKIE_SECURE=false
PORTPROJECT_RAG_COOKIE_SAMESITE=lax
PORTPROJECT_RAG_ALLOW_LEGACY_PLAINTEXT_PASSWORDS=true
PORTPROJECT_RAG_SCHEMA_NAME=rag
PORTPROJECT_RAG_DOCUMENT_SCHEMA_NAME=pms_doc
PORTPROJECT_RAG_VECTOR_SCHEMA_NAME=pms_vector
PORTPROJECT_RAG_EMBEDDING_ENDPOINT=http://127.0.0.1:11434/api/embed
PORTPROJECT_RAG_GENERATION_ENDPOINT=http://127.0.0.1:11434/api/chat
PORTPROJECT_RAG_EMBEDDING_MODEL=bge-m3
PORTPROJECT_RAG_EMBEDDING_DIMENSIONS=1024
PORTPROJECT_RAG_LLM_PRIMARY_MODEL=qwen3.5:4b
PORTPROJECT_RAG_LLM_FALLBACK_MODEL=qwen3.5:4b
PORTPROJECT_RAG_LLM_ALLOW_FALLBACK=false
PORTPROJECT_RAG_TENDER_STORAGE_PATH=tests/runtime/tender/tender_workflows.json
BILLING_TAX_MAPPING_CSV=tests/runtime/acceptance/billing_tax_mapping.csv
